# /etc/doc-catalog-mcp.env — shared by the server and the indexer units.
# Install with mode 0600: it holds the LLM API key.
#
# Everything below can also live in one YAML file instead — write it with
# `doccat config init`, point DOCCAT_CONFIG at it, and keep only the secret
# here. Variables set in this file still win over the config file.
# DOCCAT_CONFIG=/etc/doc-catalog-mcp/doccat.yaml

# --- data locations ---------------------------------------------------------
DOCS_ROOT=/srv/documents
CATALOG_PATH=/var/lib/doc-catalog-mcp/catalog.jsonl
TEXT_CACHE=/var/lib/doc-catalog-mcp/extracted_text

# --- serving ----------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8010
MCP_STATELESS=true
LOG_LEVEL=INFO

# --- the LLM used for cataloguing (indexer only) ----------------------------
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_API_KEY=changeme
LLM_MAX_TOKENS=4096
# HF_BILL_TO=BSC-LT

# --- scale ------------------------------------------------------------------
DOCCAT_LLM_WORKERS=8
DOCCAT_EXTRACT_WORKERS=0
LLM_RPS=0
# DOCCAT_PROFILE=intranet
# DOCCAT_PROFILES_DIR=/etc/doc-catalog-mcp/profiles
