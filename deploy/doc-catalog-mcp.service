# Generic MCP server unit. Settings come from /etc/doc-catalog-mcp.env
# (see deploy/doc-catalog-mcp.env.example), so one unit file serves any corpus.
#
#   sudo install -m600 deploy/doc-catalog-mcp.env.example /etc/doc-catalog-mcp.env
#   sudo cp deploy/doc-catalog-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now doc-catalog-mcp
[Unit]
Description=Document catalog MCP server (streamable HTTP)
Documentation=https://github.com/your-org/doc_catalog_mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doccat
Group=doccat
WorkingDirectory=/opt/doc-catalog-mcp
EnvironmentFile=/etc/doc-catalog-mcp.env
ExecStart=/opt/doc-catalog-mcp/.venv/bin/doccat serve
Restart=on-failure
RestartSec=5

# The service only ever reads documents — lock the rest of the system away.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/doc-catalog-mcp

[Install]
WantedBy=multi-user.target
