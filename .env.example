# Copy to .env next to docker-compose.yml (or export these) and adjust.

# ---------------------------------------------------------------- where things are
DOCUMENTS_DIR=/data/documents        # the corpus, mounted read-only
CATALOG_DIR=./catalog_data           # catalog + extracted-text cache live here
PROFILES_DIR=./profiles              # your custom cataloguing profiles (may be empty)
CONFIG_DIR=./config                  # put doccat.yaml here to configure everything
                                     # from one file (may be empty)

# ------------------------------------------------------------------- the LLM used
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=4096
# HF_BILL_TO=BSC-LT                  # Hugging Face router: organisation to bill

# ------------------------------------------------------------------------- scale
DOCCAT_LLM_WORKERS=8                 # concurrent LLM requests
DOCCAT_EXTRACT_WORKERS=0             # 0 = auto (min(cpu, 8))
LLM_RPS=0                            # cap requests/second (0 = unlimited)
# DOCCAT_PROFILE=intranet            # force one profile instead of auto-routing

# ------------------------------------------------------------------------ serving
MCP_BIND=127.0.0.1                   # 0.0.0.0 only behind a VPN or a TLS proxy
MCP_PORT=8000
MCPO_BIND=127.0.0.1
MCPO_PORT=8001
# MCPO_API_KEY=change-me             # bearer token for the OpenAPI proxy

# ------------------------------------------------------------------------- build
WITH_LIBREOFFICE=0                   # 1 converts legacy .doc/.ppt/.xls (+~450 MB)
LOG_LEVEL=INFO
